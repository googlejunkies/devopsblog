# Django Backend Configuration
DEBUG=True
SECRET_KEY=django-insecure-development-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Database Configuration
# For local Linux peer/socket connection, leave POSTGRES_HOST empty and set POSTGRES_USER to your local user
# For Docker Compose, set POSTGRES_HOST=db, POSTGRES_USER=blog_user, POSTGRES_PASSWORD=blog_password
POSTGRES_DB=blog_db
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=blog_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Development Superuser Setup
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
PORT=3000
